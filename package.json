{
  "name": "freshmarket",
  "version": "1.0.0",
  "private": true,
  "description": "FreshMarket grocery storefront: React store with a Node (Express) server and Postgres",
  "scripts": {
    "dev": "node server/index.js --dev",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "playwright test",
    "test:report": "playwright show-report",
    "lint": "eslint tests tests-smoke src server api api-tests",
    "test:api": "node --test api-tests/*.test.js",
    "test:smoke": "playwright test -c playwright.smoke.config.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@playwright/test": "^1.56.1",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.15.0",
    "eslint-plugin-playwright": "^2.1.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "vite": "^6.4.5"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "stripe": "^17.7.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rabaya-bagum/freshmarket.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/rabaya-bagum/freshmarket/issues"
  },
  "homepage": "https://github.com/rabaya-bagum/freshmarket#readme",
  "engines": {
    "node": ">=20"
  }
}
